# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Postgres CDM connection (local stand-in for Lakebase). The /api/* route handlers read this.
DATABASE_URL=postgresql://navanta:navanta@localhost:5432/navanta

# Mercer copilot API (Python FastAPI, engine repo). Defaults to http://localhost:8000 if unset.
COPILOT_URL=http://localhost:8000
